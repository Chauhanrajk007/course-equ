# Course Equivalence - optional settings
# Copy to .env, or export these as environment variables before running app.py.
# Set exactly one provider key. The advisor stays off when all three are blank.

# OpenRouter - currently working from this machine.
OPENROUTER_API_KEY=

# Groq - blocked by Cloudflare here (HTTP 403 / error 1010), not a bad key.
GROQ_API_KEY=

# xAI direct.
XAI_API_KEY=

# Force a provider instead of auto-detecting: xai | openrouter | groq
COURSE_EQUIV_PROVIDER=

# Model id. Leave blank for the provider default (x-ai/grok-4.3 on OpenRouter).
COURSE_EQUIV_MODEL=

# Keep this capped. Some gateways reject requests whose max_tokens ceiling
# exceeds the account balance.
COURSE_EQUIV_MAX_TOKENS=2000

# Set a fixed value so browser sessions survive a restart.
SECRET_KEY=

PORT=5000

# 1 = auto-reload while editing
DEBUG=